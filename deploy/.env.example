# KevinOS — variables d'environnement du déploiement.
#
# Copier ce fichier en `deploy/.env` puis renseigner les valeurs.
# ⚠️ `deploy/.env` est ignoré par Git (docs/05-securite.md §3.6) : ne JAMAIS
#    committer de secrets. Générer des secrets forts, ex. : openssl rand -base64 32

# --- Général -----------------------------------------------------------------
# Domaine interne servant au routage Traefik (résolu via /etc/hosts ou DNS local).
KEVINOS_DOMAIN=kevinos.local
TZ=Europe/Paris

# --- KevinOS Core ------------------------------------------------------------
KEVINOS_LOG_LEVEL=info
# Fournisseur IA : local (Ollama) uniquement en V1 (ADR-0006).
KEVINOS_AI_PROVIDER=local
KEVINOS_OLLAMA_BASE_URL=http://kai-ollama:11434
KEVINOS_AI_MODEL=qwen2.5:3b

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=kevinos
POSTGRES_PASSWORD=change-me-with-a-strong-secret
POSTGRES_DB=kevinos

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=change-me-with-a-strong-secret

# --- Observabilité (overlay optionnel) --------------------------------------
GRAFANA_ADMIN_PASSWORD=change-me-with-a-strong-secret
