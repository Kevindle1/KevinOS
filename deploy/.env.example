# KevinOS — variables d'environnement du déploiement.
#
# Copier en `deploy/.env` puis ajuster. ⚠️ `deploy/.env` est ignoré par Git.
# Les SECRETS (mots de passe, clés) ne sont PAS ici : ils sont gérés par fichier
# dans `deploy/secrets/` (voir deploy/secrets/README.md et ADR-0010).

# --- Général -----------------------------------------------------------------
# Domaine interne servant au routage Traefik (résolu via /etc/hosts ou DNS local).
KEVINOS_DOMAIN=kevinos.local
TZ=Europe/Paris

# --- KevinOS Core ------------------------------------------------------------
KEVINOS_LOG_LEVEL=info
# Fournisseur IA : local (Ollama) uniquement en V1 (ADR-0006).
KEVINOS_AI_PROVIDER=local
KEVINOS_OLLAMA_BASE_URL=http://kai-ollama:11434
KEVINOS_AI_MODEL=qwen2.5:3b

# --- PostgreSQL (le mot de passe est un secret : deploy/secrets/postgres_password) ---
POSTGRES_USER=kevinos
POSTGRES_DB=kevinos

# Rappel : générer les secrets avant `docker compose up` — voir
# deploy/secrets/README.md (Authelia, Postgres, Redis, Restic, Grafana).
